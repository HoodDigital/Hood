# Hood CMS — local dev environment.
#
# Copy this file to `.env.local` (gitignored) and adjust as needed:
#     cp .env.example .env.local
#
# `hood-dev` (pnpm hood …) loads `.env.local` automatically and passes it to docker compose,
# so the same values drive the app, the database container, and the schema tool. This is the
# single source of truth for the local SA password — there are no hardcoded credentials in
# docker-compose.yml.

# SA password for the local SQL Server container. Throwaway credential for local dev only —
# change it for anything exposed beyond your machine.
HOOD_SA_PASSWORD=Hood_Dev_Passw0rd!

# Optional — override the full connection string the native commands (db upgrade, run) use.
# Takes precedence over HOOD_SA_PASSWORD. Host-side connections are pinned to 127.0.0.1.
# HOOD_CONNECTION=Server=127.0.0.1,14331;Database=Hood.Web;User Id=sa;Password=Hood_Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True
