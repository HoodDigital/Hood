# pnpm: hoist into a flat node_modules so the Gulp/Rollup plugin tree resolves
# the same way it did under yarn 1.x. Revisit once the Gulp peer-dep tree is clean.
node-linker=hoisted
# Gulp/Rollup plugins declare loose/legacy peer ranges; don't fail install on them
# during the yarn→pnpm migration.
strict-peer-dependencies=false
