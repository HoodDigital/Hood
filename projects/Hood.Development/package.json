{
  "name": "hoodcms",
  "version": "7.0.0",
  "description": "A fully customisable content management system for ASP.NET Core, built on .NET 10 and EF Core 10.",
  "keywords": [
    "hood",
    "hoodcms",
    "visual-studio",
    "netcore",
    "net10.0",
    "efcore",
    "ef",
    "dotnet",
    "js",
    "ts",
    "scss"
  ],
  "homepage": "https://github.com/HoodDigital/Hood#readme",
  "bugs": {
    "url": "https://github.com/HoodDigital/Hood/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoodDigital/Hood.git",
    "directory": "projects/Hood.Development"
  },
  "license": "GPL-3.0",
  "author": "George Whysall",
  "main": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "scripts": {
    "build": "npm-run-all scss tsc",
    "build-production": "npm-run-all scss cssnano tsc tsc-production",
    "clean": "gulp clean",
    "copy": "gulp copy",
    "cssnano": "gulp cssnano",
    "package": "npm-run-all clean build-production copy views",
    "scss": "gulp scss",
    "scss-lint": "stylelint src/scss/ --fix",
    "tsc": "tsc && npm-run-all tsc-rollup",
    "tsc-production": "tsc --project tsconfig.production.json && npm-run-all tsc-rollup-production",
    "tsc-recaptcha": "tsc --project tsconfig.recaptcha.json",
    "tsc-rollup": "rollup --config --debug",
    "tsc-rollup-production": "rollup --config",
    "views": "gulp views",
    "watch-scss": "npm-watch scss",
    "watch-tsc": "npm-watch tsc"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.5",
    "@simonwep/pickr": "^1.8.2",
    "@types/bootstrap": "^5.1.12",
    "@types/dropzone": "^5.7.4",
    "@types/google.maps": "^3.49.0",
    "@types/jquery": "^3.5.14",
    "@types/jquery-toast-plugin": "^1.3.3",
    "@types/jquery.slimscroll": "^1.3.31",
    "@types/jquery.validation": "^1.16.7",
    "bootstrap": "^5.1.3",
    "chart.js": "^3.7.1",
    "dropzone": "^5.9.3",
    "hugerte": "^1.0.10",
    "jquery": "^3.6.0",
    "jquery-slimscroll": "^1.3.8",
    "jquery-toast-plugin": "^1.3.2",
    "jquery-validation": "^1.19.4",
    "sweetalert2": "^11.4.16"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-dart-sass": "^1.1.0",
    "gulp-less": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "node-sass-tilde-importer": "^1.0.2",
    "npm-run-all2": "^8.0.4",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "watch": {
    "scss": {
      "patterns": [
        "src"
      ],
      "extensions": "scss",
      "quiet": false
    },
    "tsc": {
      "patterns": [
        "src"
      ],
      "extensions": "ts",
      "quiet": false
    }
  }
}
