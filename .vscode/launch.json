{
    // Debug profiles for the Hood backend.
    //
    // These run Hood.Development LOCALLY (outside Docker) against the dockerised dev
    // SQL Server, which the compose stack exposes on host port 14331. So you can keep
    // `hood-sqlserver` running, but STOP the docker `app` container first to free port
    // 5070 — only one process can bind it, and the reCAPTCHA key is registered for the
    // `localhost` host (the port is irrelevant to reCAPTCHA's domain check).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Hood.Development (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dev",
            "program": "${workspaceFolder}/projects/Hood.Development/bin/Debug/net10.0/Hood.Development.dll",
            "args": [],
            "cwd": "${workspaceFolder}/projects/Hood.Development/",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5070",
                "ConnectionStrings__DefaultConnection": "Server=localhost,14331;Database=Hood.Web;User Id=sa;Password=Hood_Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True",
                "Hood:BypassCDN": "true",
                // Surface Hood's own logs (recaptcha pass/skip/fail/error lines) in the Debug Console.
                "Logging__LogLevel__Hood": "Information",
                "Logging__LogLevel__Hood.Services.RecaptchaService": "Information"
            }
        },
        {
            // Same as above but with EF Core SQL echoed — use when you want to watch the
            // queries (e.g. the settings read or the user/Id round-trip) as they run.
            "name": "Hood.Development (Debug + EF SQL)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dev",
            "program": "${workspaceFolder}/projects/Hood.Development/bin/Debug/net10.0/Hood.Development.dll",
            "args": [],
            "cwd": "${workspaceFolder}/projects/Hood.Development/",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5070",
                "ConnectionStrings__DefaultConnection": "Server=localhost,14331;Database=Hood.Web;User Id=sa;Password=Hood_Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True",
                "Hood:BypassCDN": "true",
                "Logging__LogLevel__Hood": "Information",
                "Logging__LogLevel__Hood.Services.RecaptchaService": "Information",
                "Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command": "Information"
            }
        },
        {
            // Attach to an already-running dotnet process (e.g. one started via the
            // "watch-dev" task) — pick Hood.Development from the process list.
            "name": "Hood.Development (Attach)",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
