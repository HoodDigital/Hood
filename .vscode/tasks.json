{
    "version": "2.0.0",
    "tasks": [
        {
            // Debug build for the F5 debugger (launch.json runs bin/Debug/.../Hood.Development.dll).
            // Stays native because it must build -c Debug; `pnpm hoodcms build` is -c Release.
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Hood.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Native publish (no hoodcms equivalent) — produces the deployable output.
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/projects/Hood.Development/Hood.Development.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Everything below is a thin wrapper over the hoodcms CLI — the CLI owns the
            // env/connection/port contract (via appsettings.Development.json), so there is
            // nothing to keep in sync here. Run them from "Tasks: Run Task".
            "label": "watch",
            "detail": "pnpm hoodcms watch — frontend + backend hot reload (Ctrl+C stops both)",
            "type": "shell",
            "command": "pnpm",
            "args": ["hoodcms", "watch"],
            "options": { "cwd": "${workspaceFolder}/projects/Hood.Development" },
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "up",
            "detail": "pnpm hoodcms up — DB upgrade, then build + start the full stack (detached)",
            "type": "shell",
            "command": "pnpm",
            "args": ["hoodcms", "up"],
            "options": { "cwd": "${workspaceFolder}/projects/Hood.Development" },
            "problemMatcher": []
        },
        {
            "label": "down",
            "detail": "pnpm hoodcms down — stop containers (keeps the DB volume)",
            "type": "shell",
            "command": "pnpm",
            "args": ["hoodcms", "down"],
            "options": { "cwd": "${workspaceFolder}/projects/Hood.Development" },
            "problemMatcher": []
        },
        {
            "label": "db-up",
            "detail": "pnpm hoodcms db-up — start SQL Server only and wait until healthy",
            "type": "shell",
            "command": "pnpm",
            "args": ["hoodcms", "db-up"],
            "options": { "cwd": "${workspaceFolder}/projects/Hood.Development" },
            "problemMatcher": []
        }
    ]
}
