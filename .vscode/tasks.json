{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-dev",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Hood.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-dev",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/projects/Hood.Development/Hood.Development.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Hot-reload run on the SAME port (5070) and DB as the debug profiles, so
            // switching between F5 debug and watch needs no other changes. Stop the
            // docker `app` container first to free 5070 (keep hood-sqlserver running).
            "label": "watch-dev",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/projects/Hood.Development/Hood.Development.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "options": {
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development",
                    "ASPNETCORE_URLS": "http://localhost:5070",
                    "ConnectionStrings__DefaultConnection": "Server=localhost,14331;Database=Hood.Web;User Id=sa;Password=Hood_Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True",
                    "Hood:BypassCDN": "true",
                    "Logging__LogLevel__Hood": "Information",
                    "Logging__LogLevel__Hood.Services.RecaptchaService": "Information"
                }
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
